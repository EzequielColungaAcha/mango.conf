{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "bottom",
  "height": 24,
  "spacing": 0,
  "expand-left": true,
  "no-center": true,

  "modules-left": ["ext/workspaces"],
  "modules-right": [
    "memory",
    "battery",
    "custom/kb_layout",
    "clock#date",
    "clock#time",
    "tray",
  ],

  "ext/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "",
      "2": "󰨞",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "7": "7",
      "8": "8",
      "9": "9",
      "urgent": "!",
    },
    "ignore-hidden": false,
    "on-click": "activate",
    "on-click-right": "deactivate",
    "sort-by-number": true,
  },

  "wlr/taskbar": {
    "format": "{title}",
    "tooltip-format": "{title}",
    "all-outputs": false,
    "expand": true,
    "active-first": false,
    "on-click": "minimize-raise",
    "on-click-middle": "close",
    "on-click-right": "maximize",
  },

  "memory": {
    "interval": 5,
    "format": "|  {used:0.1f}G ",
  },

  "battery": {
    "bat": "BAT0",
    "interval": 10,
    "states": {
      "warning": 20,
      "critical": 10,
    },
    "format": "| {icon} {capacity}% ",
    "format-charging": "| 󰂄 {capacity}% ",
    "format-plugged": "| 󰂄 {capacity}% ",
    "format-full": "| 󰁹 {capacity}% ",
    "format-icons": ["󱉞", "󱃍", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
  },

  "custom/kb_layout": {
    "interval": 1,
    "exec": "sh -c 'layout=us; if command -v mmsg >/dev/null 2>&1; then value=$(mmsg -g -k 2>/dev/null | awk \"{print \\\\$3; exit}\"); layout=${value:-us}; fi; printf \"%s\" \"$layout\"'",
    "format": "| {} ",
  },

  "clock#date": {
    "interval": 60,
    "format": "| 󰃭 {:%a %d/%m} ",
    "on-click": "zenity --calendar",
  },

  "clock#time": {
    "interval": 1,
    "format": "|  {:%H:%M} ",
    "on-click": "zenity --calendar",
  },

  "tray": {
    "icon-size": 16,
    "spacing": 2,
  },
}
