#!/usr/bin/env bash
# Waybar module: show keyboard layout from Mango's IPC when available.

layout=us

normalize_layout() {
  case "${1,,}" in
    *"english (us)"*|us)
      printf 'us'
      ;;
    *"latin american"*|*latam*)
      printf 'latam'
      ;;
    *spanish*|es)
      printf 'es'
      ;;
    "")
      printf 'us'
      ;;
    *)
      printf '%s' "$1"
      ;;
  esac
}

if command -v mmsg >/dev/null 2>&1; then
  mmsg_out=$(mmsg get keyboardlayout 2>/dev/null || true)
  if [[ -n "$mmsg_out" ]]; then
    if command -v jq >/dev/null 2>&1; then
      value=$(jq -r '.layout // empty' <<<"$mmsg_out" 2>/dev/null || true)
    else
      value=$(sed -n 's/.*"layout"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' <<<"$mmsg_out")
    fi
    layout=$(normalize_layout "${value:-$layout}")
  fi
fi

printf '%s\n' "$layout"
