#!/usr/bin/env bash

set -euo pipefail

if ! command -v veila >/dev/null 2>&1 || ! command -v veilad >/dev/null 2>&1; then
    notify-send "Veila" "Install Veila and start veilad to lock the session." 2>/dev/null || true
    exit 1
fi

bash "$HOME/.config/mango/scripts/mangoWalColors" >/dev/null 2>&1 || true

exec veila lock --wait-ready
