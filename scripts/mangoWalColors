#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MANGO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
WAL_COLORS_JSON="${WAL_COLORS_JSON:-$HOME/.cache/wal/colors.json}"
MANGO_CONFIG="${MANGO_CONFIG:-$HOME/.config/mango/config.conf}"
WAYBAR_MODULE_COLORS="${WAYBAR_MODULE_COLORS:-$HOME/.cache/wal/waybar-module-colors.css}"
SWAYNC_COLORS="${SWAYNC_COLORS:-$MANGO_DIR/swaync/colors/colors.css}"
VEILA_COLORS="${VEILA_COLORS:-$HOME/.cache/wal/veila.toml}"
WAL_WALLPAPER="${WAL_WALLPAPER:-$HOME/.cache/wal/wal}"

if [[ ! -f "$WAL_COLORS_JSON" ]]; then
  echo "mangoWalColors: missing $WAL_COLORS_JSON" >&2
  exit 1
fi

if [[ ! -f "$MANGO_CONFIG" ]]; then
  echo "mangoWalColors: missing $MANGO_CONFIG" >&2
  exit 1
fi

python3 - "$WAL_COLORS_JSON" "$MANGO_CONFIG" "$WAYBAR_MODULE_COLORS" "$SWAYNC_COLORS" "$VEILA_COLORS" "$WAL_WALLPAPER" <<'PY'
import json
import re
import sys
from pathlib import Path

wal_path = Path(sys.argv[1])
cfg_path = Path(sys.argv[2])
waybar_module_colors_path = Path(sys.argv[3])
swaync_colors_path = Path(sys.argv[4])
veila_colors_path = Path(sys.argv[5])
wal_wallpaper_path = Path(sys.argv[6])

data = json.loads(wal_path.read_text(encoding="utf-8"))
special = data.get("special", {})
colors = data.get("colors", {})

def hex_to_mango_rgba(hex_rgb: str, alpha_hex: str = "ff") -> str:
    # wal gives "#RRGGBB"
    s = hex_rgb.strip()
    if not re.fullmatch(r"#[0-9a-fA-F]{6}", s):
        raise ValueError(f"Unexpected color: {hex_rgb!r}")
    return "0x" + s[1:] + alpha_hex

def normalize_hex(hex_rgb: str) -> str:
    s = hex_rgb.strip()
    if not re.fullmatch(r"#[0-9a-fA-F]{6}", s):
        raise ValueError(f"Unexpected color: {hex_rgb!r}")
    return s

def hex_to_rgb(hex_rgb: str) -> tuple[int, int, int]:
    s = normalize_hex(hex_rgb)
    return tuple(int(s[i:i + 2], 16) for i in (1, 3, 5))

def hex_to_css_rgba(hex_rgb: str, alpha: float) -> str:
    r, g, b = hex_to_rgb(hex_rgb)
    return f"rgba({r}, {g}, {b}, {alpha:.2g})"

def relative_luminance(hex_rgb: str) -> float:
    def channel(value: int) -> float:
        c = value / 255
        return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4

    r, g, b = (channel(value) for value in hex_to_rgb(hex_rgb))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b

def contrast_ratio(first: str, second: str) -> float:
    l1 = relative_luminance(first)
    l2 = relative_luminance(second)
    lighter, darker = max(l1, l2), min(l1, l2)
    return (lighter + 0.05) / (darker + 0.05)

def best_foreground(bg: str) -> str:
    dark = special.get("background", colors.get("color0", "#000000"))
    light = special.get("foreground", colors.get("color15", "#ffffff"))
    return dark if contrast_ratio(bg, dark) >= contrast_ratio(bg, light) else light

# Opinionated mapping: keep the same semantic intent as your old config.conf
mango_colors = {
    "rootcolor": hex_to_mango_rgba(special.get("background", colors.get("color0", "#000000")), "ff"),
    "bordercolor": hex_to_mango_rgba(colors.get("color8", special.get("foreground", "#ffffff")), "ff"),
    "focuscolor": hex_to_mango_rgba(colors.get("color4", colors.get("color12", "#ffffff")), "ff"),
    "urgentcolor": hex_to_mango_rgba(colors.get("color9", colors.get("color1", "#ff0000")), "ff"),
    "globalcolor": hex_to_mango_rgba(colors.get("color4", colors.get("color12", "#ffffff")), "ff"),
    "scratchpadcolor": hex_to_mango_rgba(colors.get("color0", special.get("background", "#000000")), "ff"),
    "overlaycolor": hex_to_mango_rgba(colors.get("color7", special.get("foreground", "#ffffff")), "ff"),
    "dropcolor": hex_to_mango_rgba(colors.get("color4", colors.get("color12", "#ffffff")), "55"),
    "splitcolor": hex_to_mango_rgba(colors.get("color9", colors.get("color1", "#ff0000")), "ff"),
    "maximizescreencolor": hex_to_mango_rgba(colors.get("color15", special.get("foreground", "#ffffff")), "ff"),
}

lines = cfg_path.read_text(encoding="utf-8").splitlines(keepends=True)
key_re = re.compile(r"^(?P<key>[a-z_]+)=(?P<val>.*)$")

out = []
seen = set()
for line in lines:
    m = key_re.match(line.strip("\n"))
    if m:
        key = m.group("key")
        if key in mango_colors:
            out.append(f"{key}={mango_colors[key]}\n")
            seen.add(key)
            continue
    out.append(line)

cfg_path.write_text("".join(out), encoding="utf-8")

waybar_modules = {
    "workspaces": colors.get("color5", special.get("foreground", "#ffffff")),
    "temperature": colors.get("color6", special.get("foreground", "#ffffff")),
    "memory": colors.get("color2", special.get("foreground", "#ffffff")),
    "cpu": colors.get("color4", special.get("foreground", "#ffffff")),
    "time": colors.get("color4", special.get("foreground", "#ffffff")),
    "date": colors.get("color3", special.get("foreground", "#ffffff")),
    "tray": colors.get("color5", special.get("foreground", "#ffffff")),
    "volume": colors.get("color6", special.get("foreground", "#ffffff")),
    "backlight": colors.get("color2", special.get("foreground", "#ffffff")),
    "battery": colors.get("color4", special.get("foreground", "#ffffff")),
    "accent": colors.get("color12", colors.get("color4", special.get("foreground", "#ffffff"))),
}

css_lines = [
    "/* Generated by ~/.config/mango/scripts/mangoWalColors */\n",
    "/* Do not edit directly. */\n\n",
]
for name, bg in waybar_modules.items():
    bg = normalize_hex(bg)
    css_lines.append(f"@define-color {name}-fg {best_foreground(bg)};\n")

waybar_module_colors_path.parent.mkdir(parents=True, exist_ok=True)
waybar_module_colors_path.write_text("".join(css_lines), encoding="utf-8")

background = normalize_hex(special.get("background", colors.get("color0", "#000000")))
foreground = normalize_hex(special.get("foreground", colors.get("color15", "#ffffff")))
surface = normalize_hex(colors.get("color0", background))
surface_alt = normalize_hex(colors.get("color8", surface))
accent = normalize_hex(colors.get("color4", colors.get("color12", foreground)))
urgent = normalize_hex(colors.get("color9", colors.get("color1", accent)))

swaync_lines = [
    "/* Generated by ~/.config/mango/scripts/mangoWalColors */\n",
    "/* Do not edit directly. */\n\n",
    f"@define-color center-bg                 {hex_to_css_rgba(background, 0.8)};\n",
    f"@define-color notification-bg           {hex_to_css_rgba(background, 0.9)};\n",
    f"@define-color center-notification-bg    {hex_to_css_rgba(surface, 0.95)};\n",
    f"@define-color background                {hex_to_css_rgba(background, 0.9)};\n",
    f"@define-color background-alt            {hex_to_css_rgba(surface, 0.95)};\n",
    f"@define-color text                      {foreground};\n",
    f"@define-color text-alt                  {surface_alt};\n",
    f"@define-color accent                    {accent};\n",
    "@define-color selected                  alpha(@accent, .45);\n",
    "@define-color hover                     alpha(@selected, .45);\n",
    f"@define-color urgent                    {urgent};\n",
]

swaync_colors_path.parent.mkdir(parents=True, exist_ok=True)
swaync_colors_path.write_text("".join(swaync_lines), encoding="utf-8")

wallpaper = ""
if wal_wallpaper_path.is_file():
    wallpaper = wal_wallpaper_path.read_text(encoding="utf-8").strip()

if wallpaper:
    veila_lines = [
        "# Generated by ~/.config/mango/scripts/mangoWalColors\n",
        "# Do not edit directly.\n\n",
        "[background]\n",
        'mode = "file"\n',
        f"path = {json.dumps(wallpaper)}\n",
        'scaling = "fill"\n',
        f'color = "{background}"\n',
        "dim_strength = 18\n",
        "blur_strength = 0\n",
    ]
    veila_colors_path.parent.mkdir(parents=True, exist_ok=True)
    veila_colors_path.write_text("".join(veila_lines), encoding="utf-8")
PY

# Reload Mango config if IPC tool exists; ignore errors if not in a Mango session.
if command -v mmsg >/dev/null 2>&1; then
  mmsg -s -d reload_config >/dev/null 2>&1 || true
fi

# Reload swaync colors if it is running.
if command -v swaync-client >/dev/null 2>&1; then
  swaync-client -sw -rs >/dev/null 2>&1 || true
fi

# Reload Veila config if the daemon is running.
if command -v veila >/dev/null 2>&1; then
  veila reload >/dev/null 2>&1 || true
fi

