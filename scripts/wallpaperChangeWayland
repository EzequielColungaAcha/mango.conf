#!/usr/bin/env bash

ensure_awww_daemon() {
    if ! pgrep -x awww-daemon >/dev/null; then
        awww-daemon >/dev/null 2>&1 &
    fi
    local sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/${WAYLAND_DISPLAY:-wayland-0}-awww-daemon.sock"
    local i=0
    while (( i < 50 )); do
        if [[ -S "$sock" ]]; then
            return 0
        fi
        sleep 0.1
        ((i++))
    done
    return 1
}

set_awww_wallpaper() {
    local wallpaper="$1"
    local attempt awww_exit=1 awww_err
    for attempt in $(seq 1 15); do
        awww_err=$(mktemp)
        awww img "$wallpaper" --transition-type any --transition-step 255 --transition-fps 144 >"$awww_err" 2>&1
        awww_exit=$?
        rm -f "$awww_err"
        if (( awww_exit == 0 )); then
            return 0
        fi
        sleep 0.2
    done
    return "$awww_exit"
}

WALLPAPER_DIR="$HOME/Pictures/wallpapers"
CURRENT_WALLPAPER=$(cat ~/.cache/wal/wal 2>/dev/null || true)

ensure_awww_daemon || true

while true
do
    WALLPAPER=$(find -L "$WALLPAPER_DIR" -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) | shuf -n 1)
    if [ "$CURRENT_WALLPAPER" != "$WALLPAPER" ]
    then
        set_awww_wallpaper "$WALLPAPER" || true
        sleep 1
        wal -i "$WALLPAPER" >/dev/null 2>&1
        bash ~/.config/mango/scripts/mangoWalColors &>/dev/null || true
        if ! pgrep -x waybar >/dev/null; then
            bash ~/.config/mango/scripts/reloadWaybar &>/dev/null || true
        fi
       # killall pasystray; pasystray & > /dev/null 2>&1
       # killall blueman-applet; blueman-applet & > /dev/null 2>&1
       # killall battery-notify; bash ~/.config/mango/scripts/battery-notify & > /dev/null 2>&1
       # killall nm-applet; nm-applet --indicator & > /dev/null 2>&1
       #notify-send "Wallpaper Changed" --icon="$WALLPAPER"
        exit
    fi
done
